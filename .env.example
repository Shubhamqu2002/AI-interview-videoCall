PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
# Keep false locally. Behind exactly one trusted reverse proxy, set true.
TRUST_PROXY=false
# Leave empty for localhost-only tests. NO public third-party STUN is used.
STUN_URL=
TURN_URLS=
TURN_SECRET=
# 'relay' forces TURN for deployment verification; normally use 'all'.
ICE_TRANSPORT_POLICY=all
